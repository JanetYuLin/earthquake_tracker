<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer for Android 12+. Same policy as backup_rules.xml: keep preferences,
   skip the earthquake cache, alert bookkeeping and the last location. Keep file names in sync with data/local/AppDataStores.kt.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/earthquake_feeds.json" />
        <exclude domain="file" path="datastore/alert_state.json" />
        <exclude domain="file" path="datastore/last_location.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/earthquake_feeds.json" />
        <exclude domain="file" path="datastore/alert_state.json" />
        <exclude domain="file" path="datastore/last_location.json" />
    </device-transfer>
</data-extraction-rules>

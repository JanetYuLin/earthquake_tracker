    <!-- Safety (in details) -->
    <string name="safety_title">If you felt it</string>
    <string name="safety_bullet">•  %1$s</string>
    <string name="safety_during_title">During: Drop, Cover, and Hold On</string>
    <string-array name="safety_during_steps">
        <item>Drop to your hands and knees before the shaking knocks you down.</item>
        <item>Cover your head and neck. Get under a sturdy table or desk if one is close; otherwise get next to an interior wall away from windows.</item>
        <item>Hold on until the shaking stops, ready to move with your shelter.</item>
        <item>Don\'t run outside or stand in a doorway. If you use a wheelchair or walker, lock it and cover your head and neck.</item>
        <item>In a car, pull over away from bridges, overpasses and power lines, set the brake and stay inside.</item>
        <item>Near the coast, if shaking is strong or lasts a long time, move to high ground as soon as it stops.</item>
    </string-array>
    <string name="safety_after_title">After: stay safe</string>
    <string-array name="safety_after_steps">
        <item>Expect aftershocks. Drop, Cover, and Hold On each time.</item>
        <item>Check yourself and others for injuries. Call 911 only for life-threatening emergencies.</item>
        <item>If you smell gas, leave immediately and report it from a safe place. Don\'t use flames or switches.</item>
        <item>Stay out of damaged buildings and away from downed power lines.</item>
        <item>Text rather than call to keep lines free for emergencies, and follow official updates.</item>
    </string-array>
    <string name="safety_link_ready_gov">More from Ready.gov</string>
